{
  "name": "honobun",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @honobun/web dev",
    "dev:api": "pnpm --filter @honobun/db build && pnpm --filter @honobun/api dev",
    "db:generate": "pnpm --filter @honobun/db db:generate",
    "db:migrate": "pnpm --filter @honobun/db db:migrate",
    "db:push": "pnpm --filter @honobun/db db:push",
    "db:studio": "pnpm --filter @honobun/db db:studio",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
