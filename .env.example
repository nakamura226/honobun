# apps/api
PORT=3000
# apps/web の開発サーバーオリジン（CORS許可用）
WEB_ORIGIN=http://localhost:3001

# LLM (Vercel AI SDK) - 使用するプロバイダーのAPIキーのみ設定すればOK
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# apps/web
# apps/api のURL（hc RPCクライアントの接続先）
NEXT_PUBLIC_API_URL=http://localhost:3000

# packages/db
# Local dev (Cloud SQL Auth Proxy 経由の場合も TCP 接続でOK):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/honobun
