# cp .env.example .env

PORT=3000

# apps/web の開発サーバーオリジン（CORS許可用）
WEB_ORIGIN=http://localhost:3001

# LLM (Vercel AI SDK) - 使用するプロバイダーのAPIキーのみ設定すればOK
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# packages/db と同じPostgresを指す
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/honobun

# 画像アップロード用GCSバケット
GCS_BUCKET_NAME=honobun-dev-assets
# ローカルでfake-gcs-server等のエミュレータを使う場合のみ設定 (例: http://localhost:4443)
GCS_API_ENDPOINT=
